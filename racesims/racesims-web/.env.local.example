# Supabase — create a free project at https://supabase.com, then Project Settings
# → API. Copy these two values here into a file named `.env.local` (gitignored).
# Until these are set, the site runs fine but the Driver Account stays in
# "preview" mode (no real login).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The URL magic-link emails redirect back to. Local dev = http://localhost:4010
# Production = https://www.racesims.in (or wherever the Next app is hosted).
NEXT_PUBLIC_SITE_URL=http://localhost:4010
